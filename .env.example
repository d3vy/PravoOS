# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=changeme

DB_USER_URL=jdbc:postgresql://postgres:5432/pravoos_users
DB_USER_USERNAME=postgres
DB_USER_PASSWORD=changeme

DB_AI_URL=jdbc:postgresql://postgres:5432/pravoos_ai
DB_AI_USERNAME=postgres
DB_AI_PASSWORD=changeme

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USERNAME=mongo_user
MONGO_PASSWORD=changeme
MONGODB_URI=mongodb://mongo_user:changeme@mongodb:27017/pravoos_chat?authSource=admin

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# ─── DeepSeek ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_EMBEDDING_DIMENSIONS=1536
DEEPSEEK_MAX_TOKENS=4096

# ─── Document storage ─────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/app/documents

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_pravoos_bot
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ─── Deployment (production) ──────────────────────────────────────────────────
SERVER_IP=203.0.113.10
SERVER_DOMAIN=pravoos.example.com
ACME_EMAIL=admin@example.com
FRONTEND_PORT=80
VITE_API_URL=

# ─── Frontend (CORS, optional) ────────────────────────────────────────────────
ALLOWED_ORIGINS=
