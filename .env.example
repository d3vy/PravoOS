# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=changeme

DB_USER_URL=jdbc:postgresql://postgres:5432/pravoos_users

DB_AI_URL=jdbc:postgresql://postgres:5432/pravoos_ai

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USERNAME=mongo_user
MONGO_PASSWORD=changeme

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_TOKENS=4096

# ─── Document storage ─────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/app/documents

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_pravoos_bot
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ─── Deployment (production) ──────────────────────────────────────────────────
SERVER_IP=203.0.113.10
SERVER_DOMAIN=pravoos.example.com
ACME_EMAIL=admin@example.com
FRONTEND_PORT=80
VITE_API_URL=

# ─── Frontend (CORS, optional) ────────────────────────────────────────────────
ALLOWED_ORIGINS=
