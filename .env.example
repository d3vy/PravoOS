# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=changeme

DB_USER_URL=jdbc:postgresql://postgres:5432/pravoos_users

DB_AI_URL=jdbc:postgresql://postgres:5432/pravoos_ai

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USERNAME=mongo_user
MONGO_PASSWORD=changeme

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
# refresh-токен хранится в httpOnly-cookie. Secure=true требует HTTPS (prod).
# Для локальной разработки по http выставь REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Strict

# ─── Brute-force protection (Redis) ───────────────────────────────────────────
# Локально Redis на localhost; в docker-compose хост = redis (выставляется автоматически)
REDIS_HOST=localhost
REDIS_PORT=6379
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=PT15M
LOGIN_ATTEMPT_WINDOW=PT15M

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_TOKENS=4096

# ─── Document storage ─────────────────────────────────────────────────────────
DOCUMENT_STORAGE_PATH=/app/documents

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_pravoos_bot
TELEGRAM_ADMIN_CHAT_IDS=first-admin-chat-id,second-admin-chat-id

# ─── Inter-service secret ─────────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=changeme-generate-a-long-random-secret
USER_SERVICE_BASE_URL=http://user-service:8081

# ─── Admin seed account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_EMAIL_2=admin2@example.com
ADMIN_PASSWORD_2=changeme

# ─── Resend (email verification) ─────────────────────────────────────────────
# Получить ключ: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Для теста — оставь onboarding@resend.dev (их домен, работает сразу)
# Для прода — добавь свой домен в resend.com/domains и укажи noreply@pravoos.ru
RESEND_FROM=onboarding@resend.dev
# Базовый URL фронтенда: ссылки ведут на FRONTEND_BASE_URL/verify-email и /reset-password
FRONTEND_BASE_URL=https://pravoos.ru
RESEND_VERIFICATION_EXPIRY_HOURS=24
RESEND_PASSWORD_RESET_EXPIRY_HOURS=1

# ─── Deployment (production) ──────────────────────────────────────────────────
SERVER_IP=203.0.113.10
SERVER_DOMAIN=pravoos.example.com
ACME_EMAIL=admin@example.com
FRONTEND_PORT=80
VITE_API_URL=

# ─── Frontend (CORS, optional) ────────────────────────────────────────────────
ALLOWED_ORIGINS=

