#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   JWT_PRIVATE_KEY=$(openssl pkcs8 -topk8 -nocrypt -in jwt.pem -outform DER | base64 -w0)
#   JWT_PUBLIC_KEY=$(openssl rsa -in jwt.pem -pubout -outform DER | base64 -w0)
