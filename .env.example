# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=changeme

DB_USER_URL=jdbc:postgresql://postgres:5432/pravoos_users

DB_AI_URL=jdbc:postgresql://postgres:5432/pravoos_ai

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USERNAME=mongo_user
MONGO_PASSWORD=changeme

# ─── Kafka (KRaft, без ZooKeeper) ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Уникальный ID кластера KRaft (base64 UUID). Сгенерировать: kafka-storage random-uuid
KAFKA_CLUSTER_ID=q1Sh-edEQTSEDN1JgG7uIw

