# Профиль нагрузочного стенда. Копируется в scripts/load/.env.load.
# Значения подобраны так, чтобы мерить пулы и запросы, а не лимитеры и внешний LLM.

# --- объём данных -----------------------------------------------------------
LOAD_LAWYERS=50
LOAD_ORGS=5
LOAD_CLIENTS_PER_LAWYER=120
LOAD_CASES_PER_LAWYER=200
LOAD_TASKS_PER_CASE=4
LOAD_DOCS_PER_CASE=3
LOAD_CHUNKS_PER_DOC=8
LOAD_INVOICES_PER_LAWYER=60
LOAD_TIME_ENTRIES_PER_CASE=3
LOAD_CONVERSATIONS_PER_LAWYER=40
LOAD_MESSAGES_PER_CONVERSATION=8
LOAD_UUID_MODE=java-legacy
LOAD_USER_PASSWORD=LoadTest!2026

# --- k6 ---------------------------------------------------------------------
K6_IMAGE=grafana/k6:0.52.0
LOAD_BASE_URL=http://api-gateway:8080
LOAD_VUS=20
LOAD_DURATION=3m
LOAD_RAMP_MAX_VUS=120

# --- лимитеры на стенде -----------------------------------------------------
# Иначе профиль упирается в Redis-лимитер шлюза, а не в приложение.
# Внимание: AuthController.LOGIN_MAX_PER_IP=30/5мин — константа в коде, env её не снимает;
# run.sh чистит ключи ip_rate:login:* в Redis во время прогона.
AUTH_RATE_REPLENISH=2000
AUTH_RATE_BURST=4000
USER_RATE_REPLENISH=2000
USER_RATE_BURST=4000
AI_RATE_REPLENISH=2000
AI_RATE_BURST=4000
ADMIN_RATE_REPLENISH=2000
ADMIN_RATE_BURST=4000

# --- внешний LLM ------------------------------------------------------------
OPENAI_BASE_URL=http://mock-openai:8090/v1
OPENAI_API_KEY=mock-key
MOCK_TTFT_MS=400
MOCK_CHUNK_MS=25
MOCK_CHUNKS=60
MOCK_COMPLETION_MS=250
MOCK_EMBEDDING_MS=40
MOCK_JITTER_PCT=20

# --- измеряемый бюджет ресурсов --------------------------------------------
# Значения фиксируем явно: это и есть гипотеза, которую проверяет прогон.
DB_POOL_MAX_SIZE=16
TOMCAT_THREADS_MAX=32
TOMCAT_THREADS_MIN_SPARE=8

# Восемь async-пулов ai-service делят тот же бюджет Hikari — вот что калибрует прогон.
CHAT_STREAM_POOL_MAX=16
CHAT_CONTEXT_POOL_MAX=8
GLOBAL_SEARCH_POOL_MAX=8
DASHBOARD_POOL_MAX=8
HYBRID_SEARCH_POOL_MAX=8
TRACING_ENABLED=false
TRACING_SAMPLE_PROBABILITY=0

# Micrometer публикует готовые квантили — snapshot.sh не считает их по бакетам.
MANAGEMENT_METRICS_DISTRIBUTION_PERCENTILES_HTTP_SERVER_REQUESTS=0.95,0.99
