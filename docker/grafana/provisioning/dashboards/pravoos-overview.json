{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "PravoOS — Overview",
  "uid": "pravoos-overview",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Аутентификация",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Входы: успешные / неуспешные (rate 5m)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        { "expr": "sum by (result) (rate(pravoos_login_total[5m]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Заблокированные аккаунты (brute-force) всего",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "sum(pravoos_login_total{result=\"locked\"})", "legendFormat": "locked" }
      ]
    },
    {
      "type": "row",
      "title": "Заявки юристов",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "Заявки: подано / одобрено / отклонено (rate 1h)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "targets": [
        { "expr": "sum by (action) (increase(pravoos_application_total[1h]))", "legendFormat": "{{action}}" }
      ]
    },
    {
      "type": "row",
      "title": "Очереди Kafka",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "type": "stat",
      "title": "Сообщения в DLT (всего)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "targets": [
        { "expr": "sum(pravoos_kafka_dlt_total)", "legendFormat": "DLT" }
      ]
    },
    {
      "type": "timeseries",
      "title": "DLT rate по топикам (5m)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "targets": [
        { "expr": "sum by (topic) (rate(pravoos_kafka_dlt_total[5m]))", "legendFormat": "{{topic}}" }
      ]
    },
    {
      "type": "row",
      "title": "HTTP / сервисы",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }
    },
    {
      "type": "timeseries",
      "title": "HTTP-запросы по сервисам (rate 5m)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "sum by (service) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx по сервисам (rate 5m)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{service}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used по сервисам",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        { "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{service}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 HTTP (s)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{service}}" }
      ]
    }
  ]
}
